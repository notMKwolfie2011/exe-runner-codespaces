{
  "name": "exe-runner-codespaces",
  "version": "1.0.0",
  "description": "Run .exe files and games in GitHub Codespaces",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "setup": "mkdir -p executables && echo 'Environment ready!'",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node backend/server.js",
    "client": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "child_process": "^1.0.2"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.3.9",
    "concurrently": "^8.2.0",
    "axios": "^1.4.0"
  }
}
